{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "path": {
      "*": "allow",
      ".envrc.local": "deny",
      "secrets.yaml": "deny",
      "kubeconfig": "deny",
      "talosconfig": "deny",
      "controlplane.yaml": "deny",
      "worker.yaml": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "~/dev/go": "allow",
      "/nix/store": "allow"
    },
    "bash": {
      "*": "ask",
      "echo *": "allow",
      "printf *": "allow",
      "cd *": "allow",
      "for *": "allow",
      "set *": "allow",
      "test *": "allow",
      "command *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "fd *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "nl *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "cat *": "ask",
      "pwd": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "jj st *": "allow",
      "jj status *": "allow",
      "jj log *": "allow",
      "jj show *": "allow",
      "jj diff *": "allow",
      "yq *": "allow",
      "jq *": "allow",
      "go env *": "allow",
      "kubectl kustomize *": "allow",
      "helm template *": "allow"
    },
    "*": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "copy": "ask",
    "move": "ask",
    "replace_match": "ask"
  }
}
