{
  "permission": {
    "path": {
      "*": "allow",
      ".envrc.local": "deny",
      "secrets.yaml": "deny",
      "kubeconfig": "deny",
      "talosconfig": "deny",
      "controlplane.yaml": "deny",
      "worker.yaml": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "~/dev/go": "allow"
    },
    "bash": {
      "*": "ask",
      "find *": "allow",
      "grep *": "allow",
      "fd *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "nl *": {
        "action": "deny",
        "reason": "use your read tool"
      },
      "cat *": "allow",
      "pwd": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "yq *": "allow",
      "jq *": "allow",
      "go env *": "allow"
    },
    "read": "allow",
    "edit": "ask",
    "write": "ask",
    "todo": "allow",
    "memory": "allow",
    "memory_search": "allow",
    "web_search": "allow",
    "web_fetch": "allow",
    "ask_user_question": "allow",
    "mem_*": "allow"
  }
}
