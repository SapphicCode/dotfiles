{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".envrc.local": "deny",
      "secrets.yaml": "deny",
      "kubeconfig": "deny",
      "talosconfig": "deny",
      "controlplane.yaml": "deny",
      "worker.yaml": "deny"
    },
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "jj log *": "allow",
      "jj status *": "allow",
      "jj show *": "allow",
      "jj diff *": "allow",
      "go env *": "allow",
      "go doc *": "allow"
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://clementine.atlas-ide.ts.net:1234/v1"
      },
      "models": {
        "qwen3.5-27b": {
          "name": "Qwen3.5 27b",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        "gemma-4-31b-it": {
          "name": "Gemma 4 31b Instruct",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        "qwen3.5-27b-claude-4.6-opus-distilled-mlx": {
          "name": "Qwen3.5 27b (Claude 4.6 Opus Distilled)",
          "limit": {
            "output": 131072,
            "context": 131072
          }
        }
      }
    }
  }
}
