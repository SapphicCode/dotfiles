[core]
    hooksPath = ~/.config/git/hooks
    pager = delta
    excludesFile = ~/.config/git/template/.gitignore

[user]
    name = Cassandra
    email = {{ b64dec "Z2l0QHNhcHBoaWNjby5kZQ==" }}
    signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO9xeCEREM1kRjHme9h6w41x/DayIQYV5+Sb1GsJhW9k"

[init]
    defaultBranch = main
    template = ~/.config/git/template

[interactive]
    diffFilter = delta --color-only

[commit]
    template = ~/.config/git/commit_template.txt
    gpgsign = true

[gpg]
    format = "ssh"

[gpg.ssh]
    program = "{{ .chezmoi.homeDir }}/.config/git/ssh-keygen"

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = diff3

{{ if (lookPath "mergiraf") -}}
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P
{{- end }}

[rebase]
    autoStash = true

[branch]
    sort = -committerdate

[credential]
    helper = cache --timeout 43200  # 60 * 60 * 12 = 12 hours
{{- if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{- else if and (eq .chezmoi.os "linux") (or (lookPath "kwallet-query") (lookPath "gnome-keyring")) }}
    helper = libsecret
{{- else }}
    helper = store
{{- end }}

[alias]
    back = checkout @{-1}

    stage = add
    unstage = restore --staged

    undo = reset --soft HEAD~1
    redo = reset --mixed HEAD@{1}

    sync = ! git pull && git push

    wt = worktree

    root = rev-parse --show-toplevel

[credential "https://github.com"]
    helper =
    helper = !~/.nix-profile/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !~/.nix-profile/bin/gh auth git-credential

[include]
    path = ~/.config/git/hconfig

[includeIf "gitdir:~/dev/work/"]
    path = ~/.config/git/work/config

[includeIf "gitdir:/Volumes/Work/"]
    path = ~/.config/git/work/config
[includeIf "gitdir:/Volumes/Work/"]
    path = /Volumes/Work/.gitconfig

[includeIf "gitdir:/work/"]
    path = ~/.config/git/work/config
[includeIf "gitdir:/work/"]
    path = /work/.gitconfig
