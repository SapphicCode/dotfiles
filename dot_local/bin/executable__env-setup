#!/usr/bin/env nu

# This script attempts to set up environment variables for any kind of shell.
# It is intended to be sourced by the various shell configuration files.

def quote [] {
    mut o = $in
    if ($o | describe) == "list<string>" {
        $o = $o | str join ":"
    }
    $o = $o | str replace '"' '\"'
    $"\"($o)\""
}

def main [flavor: string] {
    mut path = $env.PATH
    mut out = {}

    # platform detection
    let platform = (sys host | get name)
    let cache = if $platform == "Darwin" {
        $"($env.HOME)/Library/Caches"
    } else {
        $"($env.HOME)/.cache"
    }

    # app-specific stuff:

    # golang
    $out.GOPATH = $"($env.HOME)/dev/go"
    $out.CGO_ENABLED = "0"

    # npm
    $out.npm_config_cache = $"($cache)/npm"

    # pnpm
    $out.PNPM_HOME = $"($cache)/pnpm"

    # bun
    $out.BUN_INSTALL_CACHE_DIR = $"($cache)/bun"

    # rclone
    $out.RCLONE_FAST_LIST = "1"

    # editor and manpager
    # in order of preference
    if not (which hx | is-empty) {
        $out.EDITOR = "hx"
    } else if not (which micro | is-empty) {
        $out.EDITOR = "micro"
    } else if not (which nvim | is-empty) {
        $out.EDITOR = "nvim"
        $out.MANPAGER = "nvim +Man!"
    }

    # override EDITOR based on TERM_PROGRAM
    if ($env | get -o TERM_PROGRAM) == "vscode" {
        $out.EDITOR = "code -w"
    }
    if ($env | get -o TERM_PROGRAM) == "zed" {
        $out.EDITOR = "zed -w"
    }

    # path stuff follows:
    # *deep breath*

    # homebrew
    if ("/opt/homebrew/" | path exists) {
        $path = $path | prepend [
            "/opt/homebrew/bin"
            "/opt/homebrew/sbin"
        ]
    }

    # Nix stuff
    # check for /nix existence
    if ("/nix/" | path exists) {
        $path = $path | prepend [
            $"($env.HOME)/.local/share/devbox/global/default/.devbox/nix/profile/default/bin",
            $"($env.HOME)/.nix-profile/bin",
            "/nix/var/nix/profiles/default/bin",
        ]
        if (sys host | get name) == "NixOS" {
            # add NixOS setuid binaries in front of the above
            $path = $path | prepend ["/run/wrappers/bin"]
        }
    }

    # gobin
    $path = $path | prepend $"($out.GOPATH)/bin"

    # user path
    $path = $path | prepend [
        $"($env.HOME)/.local/bin",
        $"($env.HOME)/bin",
    ]

    $path = $path | uniq

    # export it all
   $out.PATH = $path
    match $flavor {
        json => {
            print ($out | to json)
        }
        bash => {
            print (
                $out
                | items { |k, v| $"export ($k)=($v | quote)" }
                | str join "\n"
            )
        }
        fish => {
            print (
                $out
                | items { |k, v| $"set -g -x ($k) ($v | quote)" }
                | str join "\n"
            )
        }
        _ => {
            print $"Unsupported shell flavor: ($flavor)"
            exit 1
        }
    }

}
